{
  "name": "ops-mitra-server",
  "version": "0.1.0",
  "description": "OpsMitra backend — Fastify + Drizzle + PostgreSQL",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm exec tsup src/index.ts --format esm --dts --out-dir dist --clean",
    "start": "node dist/index.js",
    "test": "tsx src/test/intelligence.test.ts && tsx src/test/milestone4.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "copy:public": "node -e \"const fs = require('node:fs'); fs.rmSync('public', {recursive: true, force: true}); fs.cpSync('../dist', 'public', {recursive: true});\"",
    "build:all": "cd .. && pnpm install --config.production=false && pnpm run build && cd server && pnpm install --config.production=false && pnpm run build && pnpm run copy:public"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/sensible": "^6.0.3",
    "@fastify/static": "^8.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.41.0",
    "fastify": "^5.3.3",
    "fastify-plugin": "^5.0.1",
    "postgres": "^3.4.7",
    "zod": "^3.24.3",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.30.4",
    "pino-pretty": "^13.1.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

# OpsMitra Backend Environment Variables
#
# NOTE: Never commit production secrets to version control.
# Copy this file to .env and fill in the values for local development.

# Required: Connection string for PostgreSQL database
DATABASE_URL=

# Required: Port for the backend server
PORT=3001

# Required: Host binding. Default '::' allows both IPv4 and IPv6, required for Railway.
HOST=::

# Required: Node environment (development, test, production)
NODE_ENV=production

# Required for production: The frontend origin(s) allowed to make requests to this API.
# Multiple origins can be comma-separated.
CORS_ORIGIN=

# Optional: API keys for AI services. At least one is required if not using fallback mode.
GEMINI_API_KEY=
OPENAI_API_KEY=

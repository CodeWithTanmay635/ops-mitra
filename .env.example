# OpsMitra Frontend Environment Variables
#
# NOTE: Never commit production secrets or real production URLs to version control.
# Copy this file to .env and fill in the values for local development.

# Required: The base URL of the backend API. 
# For local development, this is typically http://localhost:3001.
# In production, set this to the deployed backend URL (e.g. your Railway URL).
VITE_API_URL=http://localhost:3001
